# Smart Search v2 - Environment Config
# NOTE: Smart Search v2 automatically includes 7 live free search APIs
# (Wikipedia, DuckDuckGo, HackerNews, Crossref, StackOverflow, ArXiv, Wikinews)
# and live autocomplete suggestions without requiring any API keys!

# Optional Keyed Search Providers (uncomment and add your key if desired):

# 1. Google Custom Search API: https://developers.google.com/custom-search/v1
GOOGLE_API_KEY=your_google_api_key_here
GOOGLE_SEARCH_ENGINE_ID=your_search_engine_id_here

# 2. Brave Web Search API: https://brave.com/search/api/ (2,000 free queries/month)
# BRAVE_SEARCH_API_KEY=your_brave_api_key_here

# 3. Serper Google Search JSON API: https://serper.dev (2,500 free queries)
# SERPER_API_KEY=your_serper_api_key_here

# 4. Tavily AI Search: https://tavily.com (1,000 free queries/month)
# TAVILY_API_KEY=your_tavily_api_key_here

# Server port (default: 3000)
PORT=3000

